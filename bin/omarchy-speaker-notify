#!/usr/bin/python3
# Pinned to /usr/bin/python3 deliberately: PyGObject lives in the system
# interpreter, and a mise shim ahead of it on PATH does not have it.
"""Bridge phone message notifications to the desktop over Bluetooth MAP.

MAP (Message Access Profile) is a standard Bluetooth profile that both Android
and iOS implement, so there is nothing vendor-specific here. It exposes the
phone's *message store*, which means SMS: an iPhone advertises SupportedTypes
SMS_GSM, so not even iMessage appears, and no third-party app ever will. The
phone must grant notification access first — iOS asks once, per device, and
refuses with OBEX 0xC3 Forbidden until it is given.

This has to be a daemon rather than a shell-out: obexd destroys a session the
moment the D-Bus client that created it disconnects, so something must hold the
connection for as long as notifications should flow.

Message contents are never logged. --debug prints event structure only.

Usage: omarchy-speaker-notify <device-mac> [--debug]
"""

import collections
import os
import re
import subprocess
import sys

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

OBEX = "org.bluez.obex"
MNS_TARGET = "BB582B41-420C-11DB-B0DE-0800200C9A66"
MAC_RE = re.compile(r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")

# Sender and subject come from the phone. They are shown, never interpreted,
# but a notification is a small box, so they are trimmed to printable text of
# a size that fits one. MAP subjects are shorter than this to begin with.
TEXT_LIMIT = 200
# Message object paths are remembered so a status change on an old message is
# not announced again; the set is bounded so a long session cannot grow it
# without limit. A phone re-reporting something older than this many messages
# would show once more, which is harmless.
SEEN_LIMIT = 512
NOTIFY_TIMEOUT = 10

DEBUG = "--debug" in sys.argv


def log(*a):
    if DEBUG:
        print(*a, file=sys.stderr, flush=True)


def clean(text):
    """Printable, bounded text for a notification."""
    kept = "".join(ch for ch in str(text or "") if ch.isprintable())
    return kept.strip()[:TEXT_LIMIT]


def notify(title, body):
    """Hand off to the desktop. Contents are never logged.

    `--` keeps a sender that happens to start with a dash from being read as
    an option. The call is bounded: a notification daemon that does not answer
    must not stall the bridge.
    """
    cmd = ["notify-send", "-a", "Messages", "-i", "phone", "--",
           clean(title) or "Message"]
    body = clean(body)
    if body:
        cmd.append(body)
    try:
        subprocess.run(cmd, check=False, timeout=NOTIFY_TIMEOUT,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError) as e:
        log("notify-send failed:", type(e).__name__)


class Map:
    def __init__(self, mac):
        self.mac = mac
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.session = None
        self.seen = collections.OrderedDict()

    def start(self):
        client = Gio.DBusProxy.new_sync(
            self.bus, Gio.DBusProxyFlags.NONE, None,
            OBEX, "/org/bluez/obex", "org.bluez.obex.Client1", None)
        args = GLib.Variant("(sa{sv})",
                            (self.mac, {"Target": GLib.Variant("s", "map")}))
        self.session = client.call_sync("CreateSession", args,
                                        Gio.DBusCallFlags.NONE, 30000, None)[0]
        log("MAP session:", self.session)
        self.bus.signal_subscribe(
            OBEX, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded",
            None, None, Gio.DBusSignalFlags.NONE, self.on_interfaces_added)

    def stop(self):
        if not self.session:
            return
        try:
            client = Gio.DBusProxy.new_sync(
                self.bus, Gio.DBusProxyFlags.NONE, None,
                OBEX, "/org/bluez/obex", "org.bluez.obex.Client1", None)
            client.call_sync("RemoveSession",
                             GLib.Variant("(o)", (self.session,)),
                             Gio.DBusCallFlags.NONE, 10000, None)
        except Exception as e:
            log("RemoveSession failed:", e)
        self.session = None

    def on_interfaces_added(self, _c, _s, _p, _i, _sig, params):
        obj, ifaces = params.unpack()
        for name, props in ifaces.items():
            if name == "org.bluez.obex.Session1" and props.get("Target") == MNS_TARGET:
                log("phone opened its notification channel")
            elif name == "org.bluez.obex.Message1":
                # A phone re-reports the same message as its status changes;
                # only the first sighting is news.
                if obj in self.seen:
                    return
                self.seen[obj] = True
                while len(self.seen) > SEEN_LIMIT:
                    self.seen.popitem(last=False)
                log("message event")
                notify(props.get("Sender") or props.get("SenderAddress") or "Message",
                       props.get("Subject", ""))


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args or not MAC_RE.match(args[0]):
        print("usage: omarchy-speaker-notify <device-mac> [--debug]",
              file=sys.stderr)
        return 2

    bridge = Map(args[0])
    try:
        bridge.start()
    except Exception as e:
        print(f"speaker-notify: {e}", file=sys.stderr)
        return 1

    loop = GLib.MainLoop()

    def bail(*_):
        bridge.stop()
        loop.quit()
        return False

    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except (ValueError, ImportError):
        add_signal = GLib.unix_signal_add
    add_signal(GLib.PRIORITY_DEFAULT, 15, bail)
    add_signal(GLib.PRIORITY_DEFAULT, 2, bail)

    # `omarchy plugin remove` just deletes the directory — there is no
    # uninstall hook to run. A daemon started from inside that directory would
    # otherwise keep running against a plugin that no longer exists, so it
    # notices its own removal and stops.
    def still_installed():
        if os.path.exists(__file__):
            return True
        log("plugin directory is gone; shutting down")
        bail()
        # bail() unwinds the loop, but give it a moment and then make sure the
        # process is really gone rather than trusting it to be.
        GLib.timeout_add_seconds(2, lambda: os._exit(0))
        return False
    GLib.timeout_add_seconds(30, still_installed)

    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
